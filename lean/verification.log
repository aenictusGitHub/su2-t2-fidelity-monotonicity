info: Audit.lean:15:0: def SU2T2.Choi.CompletelyPositive : {n : ℕ} → (SU2T2.Choi.Mat n →ₗ[ℂ] SU2T2.Choi.Mat n) → Prop :=
fun {n} φ =>
  ∀ (k : ℕ) (X : Matrix (Fin n × Fin k) (Fin n × Fin k) ℂ), X.PosSemidef → (SU2T2.Choi.amplification φ k X).PosSemidef
info: Audit.lean:16:0: def SU2T2.Dicke.CovariantStates : (n : ℕ) → (SU2T2.Spin.Mat n →ₗ[ℂ] SU2T2.Spin.Mat n) → Prop :=
fun n φ =>
  ∀ (U : ↥SU2T2.Dicke.SU2) (ρ : SU2T2.Spin.Mat n),
    Matrix.PosSemidef ρ →
      Matrix.trace ρ = 1 →
        φ (SU2T2.Dicke.action n U * ρ * Matrix.conjTranspose (SU2T2.Dicke.action n U)) =
          SU2T2.Dicke.action n U * φ ρ * Matrix.conjTranspose (SU2T2.Dicke.action n U)
info: Audit.lean:17:0: def SU2T2.Dicke.action : (n : ℕ) → ↥SU2T2.Dicke.SU2 → SU2T2.Spin.Mat n :=
fun n U => (SU2T2.Dicke.embedding n).conjTranspose * SU2T2.Dicke.tensorPower (↑U) n * SU2T2.Dicke.embedding n
info: Audit.lean:18:0: def SU2T2.marginal2 : (N : ℕ) → 3 ≤ N → SU2T2.Spin.Mat N → SU2T2.Cartesian.ComplexThree :=
fun N hN ρ => SU2T2.Physical.twoMarginal (N - 3) (Matrix.submatrix ρ (Fin.cast ⋯) (Fin.cast ⋯))
info: Audit.lean:19:0: def SU2T2.fidelityTotal2 : (N : ℕ) → 3 ≤ N → SU2T2.Spin.Mat N → ℝ :=
fun N hN ρ => SU2T2.matrixFidelity2 (SU2T2.marginal2 N hN ρ)
info: Audit.lean:20:0: def SU2T2.matrixFidelity2 : SU2T2.QutritMatrix → ℝ :=
fun A => ((Matrix.trace (CFC.sqrt A)).re ^ 2 - 1) / 2
